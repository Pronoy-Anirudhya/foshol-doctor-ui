# Rendered at container start by the stock entrypoint's 20-envsubst-on-templates.sh into
# /etc/nginx/conf.d/default.conf. NGINX_ENVSUBST_FILTER (set in docker-compose.yml) pins exactly
# which ${NAMES} are substituted, so every lowercase $variable below — an nginx runtime variable,
# not an environment one — survives untouched.

server {
    listen      8080;
    listen      [::]:8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    server_tokens     off;
    absolute_redirect off;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    client_body_timeout  60s;

    gzip            on;
    gzip_static     on;   # serve the .gz the build stage already produced, at no CPU cost
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_proxied    any;
    gzip_comp_level 6;
    gzip_types      text/plain text/css text/javascript application/javascript
                    application/json application/manifest+json image/svg+xml;
    # woff2 is omitted deliberately: it is Brotli-compressed internally, so gzip spends CPU for
    # roughly nothing.

    include /tmp/nginx/security-headers.conf;

    # ── Liveness ────────────────────────────────────────────────────────────────────────────
    # Answered by nginx alone. A backend outage must never restart or unhealth the frontend: the
    # app is genuinely usable with the API down, and start-ui.sh already treats a failed backend
    # probe as a warning rather than an error.
    location = /healthz {
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    # ── Runtime config ──────────────────────────────────────────────────────────────────────
    # Baked into the image for this deployment shape (same-origin), but never cached: a cached
    # env.js would outlive a container restart, which is the one failure a restart cannot fix.
    location = /env.js {
        include /tmp/nginx/security-headers.conf;
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
    }

    # try_files' internal redirect re-enters location matching, so the index.html served as a
    # deep-link fallback lands here too and is also no-store. That is what makes a new deploy
    # visible without a hard refresh.
    location = /index.html {
        include /tmp/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # ── Hashed build output: main-XXXXXXXX.js, styles-XXXXXXXX.css, chunk-XXXXXXXX.js ───────
    location ~* "^/[^/]+-[A-Z0-9]{8}\.(?:js|css)$" {
        include /tmp/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # ── public/** is copied VERBATIM by the assets glob ─────────────────────────────────────
    # outputHashing:"all" does NOT hash these, so an immutable year would pin a stale Bangla
    # catalogue in every farmer's browser with no way to push a correction.
    location ^~ /i18n/ {
        include /tmp/nginx/security-headers.conf;
        default_type application/json;
        add_header Cache-Control "no-cache" always;   # cache, but revalidate on every load
        try_files $uri =404;
    }

    location ^~ /fonts/ {
        include /tmp/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000" always;   # 30d; also unhashed
        try_files $uri =404;
    }

    location ~* "^/favicon\.(?:ico|svg)$" {
        include /tmp/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # ── The 30-minute stream ────────────────────────────────────────────────────────────────
    # Declared before /api/ and as an EXACT match so it wins. sse.timeoutMs is 1_800_000 and
    # staleAfterMs is 50_000: a buffering proxy holds the 20s heartbeat comments back, the client
    # watchdog fires at 50s, and the console reconnects forever while the stream is in fact
    # healthy — with nothing in any log to say why.
    location = /api/v1/stream {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass ${BACKEND_API_BASE_URL};

        proxy_buffering           off;
        proxy_request_buffering   off;
        proxy_cache               off;
        gzip                      off;
        chunked_transfer_encoding on;
        proxy_read_timeout        ${SSE_PROXY_READ_TIMEOUT};
        proxy_send_timeout        ${SSE_PROXY_READ_TIMEOUT};
    }

    # ── Everything else under /api ──────────────────────────────────────────────────────────
    # proxy_pass carries NO URI part, so the request URI is forwarded unchanged and the generated
    # client's /api/v1/... paths arrive intact. Adding a trailing slash here breaks every call.
    location /api/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass ${BACKEND_API_BASE_URL};

        proxy_read_timeout ${API_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${API_PROXY_READ_TIMEOUT};
    }

    # ── SPA fallback ────────────────────────────────────────────────────────────────────────
    # Router deep links (/officer/queue/tasks/{id}, /farmer/cases/{id}) are client-side paths;
    # <base href="/"> in src/index.html is what makes root-relative assets correct from any depth.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
