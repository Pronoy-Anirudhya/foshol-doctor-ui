{
  "name": "foshol-doctor-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm run i18n:build && ng serve --port 4200",
    "build": "pnpm run i18n:build && ng build",
    "test": "pnpm run i18n:build && ng test",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:gen": "pnpm run api:sync && ng-openapi-gen -c ng-openapi-gen.json",
    "i18n:build": "node scripts/merge-i18n.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:generated": "pnpm run api:gen && git diff --exit-code --stat src/app/generated openapi",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "verify": "pnpm run i18n:check && pnpm run check:pins && pnpm run check:arch && pnpm run check:contrast && pnpm run typecheck",
    "verify:all": "pnpm run verify && pnpm run check:generated && ng build --configuration production && ng test --no-watch"
  },
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/router": "22.1.5",
    "@ngx-translate/core": "18.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@tailwindcss/postcss": "4.3.3",
    "jsdom": "28.1.0",
    "ng-openapi-gen": "1.0.5",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "volta": {
    "node": "24.15.0"
  }
}
