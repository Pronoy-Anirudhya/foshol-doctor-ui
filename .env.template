# ════════════════════════════════════════════════════════════════════════════════════════════
# Foshol Doctor — frontend container configuration
#
#     cp .env.template .env    &&    edit    &&    docker compose up -d --build
#
# EVERY value here is read at CONTAINER START. Change one, run `docker compose up -d`, and the
# running container picks it up. The Angular bundle is never rebuilt.
#
# Checklist — required:  BACKEND_API_BASE_URL
#             review:    MEDIA_OBJECT_STORE_ORIGIN, CSP_HEADER_NAME, HTTP_PORT
#             defaulted: everything else (safe to leave alone)
# ════════════════════════════════════════════════════════════════════════════════════════════

# ── REQUIRED · the frontend-to-backend mapping ──────────────────────────────────────────────
# Where the backend API lives, as seen FROM THIS VM — not from the browser. nginx makes the call;
# the browser only ever talks to this container. That is why no CORS entry is needed on the
# backend and why the page can be HTTPS while this hop stays plain HTTP on the private network.
#
#   MUST be    scheme://host[:port]
#   MUST NOT   end in a slash    -> proxy_pass then REPLACES the path: /api/v1/cases becomes
#                                   /v1/cases and every call 404s while the SPA still loads
#   MUST NOT   contain a path    -> same failure
#
# Prefer an IP. nginx resolves this ONCE at config load, so an unresolvable hostname stops the
# container from starting rather than failing at the first request.
# The entrypoint validates all three rules and refuses to start on a bad value.
BACKEND_API_BASE_URL=http://10.0.0.12:8080

# ── Publishing ──────────────────────────────────────────────────────────────────────────────
HTTP_PORT=80
# 127.0.0.1 when a host TLS terminator (nginx, Caddy, Traefik) fronts this container.
HTTP_BIND_ADDRESS=0.0.0.0

# ── Image ───────────────────────────────────────────────────────────────────────────────────
IMAGE_NAME=foshol-doctor-ui
IMAGE_TAG=local
# true runs `npm run verify` inside the build (i18n parity, exact pins, architecture lint, WCAG
# contrast, tsc strict). Slower builds, earlier failures.
# NEVER point this at verify:all — scripts/sync-openapi.mjs reads an absolute path on a
# developer's Mac that exists in no container.
RUN_VERIFY=false

# ── Content-Security-Policy ─────────────────────────────────────────────────────────────────
# FIRST DEPLOY: leave this as Report-Only, walk every screen, watch the browser console, then
# switch to Content-Security-Policy. A wrong img-src blanks the officer queue's thumbnails with
# nothing on screen to explain it.
CSP_HEADER_NAME=Content-Security-Policy-Report-Only

# The object store (MinIO) the backend presigns URLs against. Those URLs bind straight to
# <img [src]> and <audio [src]>, and the Grad-CAM request is 302'd into this origin — CSP applies
# to redirect targets, which is why it appears in connect-src as well as img-src/media-src.
MEDIA_OBJECT_STORE_ORIGIN=http://10.0.0.12:9000
CSP_MEDIA_SRC=${MEDIA_OBJECT_STORE_ORIGIN}
CSP_CONNECT_SRC=${MEDIA_OBJECT_STORE_ORIGIN}

# ── nginx tuning · defaults are sized to this app, change with care ─────────────────────────
# >= 3 x intake.maxImageBytes (8 MiB) + intake.maxAudioBytes (4 MiB) + multipart overhead.
# nginx's own default is 1m, which 413s every real case submission while a one-image smoke test
# passes cleanly.
NGINX_CLIENT_MAX_BODY_SIZE=32m

# >= faq.requestTimeoutMs (45s). The Whisper sidecar genuinely takes that long on a voice search.
API_PROXY_READ_TIMEOUT=90s

# >= sse.timeoutMs (1_800_000 ms = 30 min), with margin. Too low and the officer console's live
# stream is severed mid-shift and reconnects silently.
SSE_PROXY_READ_TIMEOUT=1830s

# ── Runtime limits ──────────────────────────────────────────────────────────────────────────
CPU_LIMIT=1.0
MEMORY_LIMIT=256M
MEMORY_RESERVATION=64M
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
TZ=Asia/Dhaka
